{
  "name": "Gamificador",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:juliobudiski/Gamificador.git",
  "author": "LucasSarri <lucassarri@hotmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsc && copyfiles -u 1 src/views/**/* dist/views && copyfiles -u 1 src/public/**/* dist/public",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node ./src/index.ts",
    "migration:create": "typeorm migration:create ./src/migrations/default",
    "migration:generate": "typeorm-ts-node-commonjs -d ./src/data-source.ts migration:generate ./src/migrations/default",
    "migration:run": "typeorm-ts-node-commonjs -d ./src/data-source.ts migration:run"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.15",
    "body-parser": "^1.20.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  }
}
