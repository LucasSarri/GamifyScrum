<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/style.css">
        <title>Gamificador</title>
    </head>
<body>
    <div class="centraliza_div">
        <h1>Mapeamento</h1>
        <form action="/mapeamento" method="post">
            <div class="form-columns">
                <div class="column">
                    <h2>Modalidade</h2>
                    <% for(let i=0; i < mapeamentos.length; i++) { %>
                        <% if(mapeamentos[i].ag_mapeamento.id == 1) { %>
                            <div>
                                <input type="checkbox" name="ativo" value="<%=mapeamentos[i].id%>">
                                <%=mapeamentos[i].descricao%>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <div class="column">
                    <h2>Tipos</h2>
                    <% for(let i=0; i < mapeamentos.length; i++) { %>
                        <% if(mapeamentos[i].ag_mapeamento.id == 2) { %>
                            <div>
                                <input type="checkbox" name="ativo" value="<%=mapeamentos[i].id%>">
                                <%=mapeamentos[i].descricao%>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <div class="column">
                    <h2>Geral</h2>
                    <% for(let i=0; i < mapeamentos.length; i++) { %>
                        <% if(mapeamentos[i].ag_mapeamento.id == 3) { %>
                            <div>
                                <input type="checkbox" name="ativo" value="<%=mapeamentos[i].id%>">
                                <%=mapeamentos[i].descricao%>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <div>
                    <input type="number" name="idPlanejamento" value="<%=planejamento%>" readonly hidden>
                </div>
            </div>

            <button class="btn-principal"><a href="/elementos_gamificacao/<%=planejamento%>">Voltar</a></button>
            <button type="submit" class="btn-principal">Próximo</button>
        </form>
    </div>
</body>
</html>