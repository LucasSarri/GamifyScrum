<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/style.css">
        <title>Gamificador</title>
    </head>
<body>
    <div class="centraliza_div">
        <h1>Elementos Gamificação</h1>
        <form action="/elementos_gamificacao" method="post">
            <div class="form-columns">
                <div class="column">
                    <h2>Desempenho</h2>
                    <% for(let i=0; i < gamificacao.length; i++) { %>
                        <% if(gamificacao[i].ag_gamificacao.id == 1) { %>
                            <div>
                                <input type="checkbox" name="ativo" value="<%=gamificacao[i].id%>">
                                <input type="text" name="descricao" value="<%=gamificacao[i].descricao%>">
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <div class="column">
                    <h2>Ecológico</h2>
                    <% for(let i=0; i < gamificacao.length; i++) { %>
                        <% if(gamificacao[i].ag_gamificacao.id == 2) { %>
                            <div>
                                <input type="checkbox" name="ativo" value="<%=gamificacao[i].id%>">
                                <input type="text" name="descricao" value="<%=gamificacao[i].descricao%>">
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <div class="column">
                    <h2>Social</h2>
                    <% for(let i=0; i < gamificacao.length; i++) { %>
                        <% if(gamificacao[i].ag_gamificacao.id == 3) { %>
                            <div>
                                <input type="checkbox" name="ativo" value="<%=gamificacao[i].id%>">
                                <input type="text" name="descricao" value="<%=gamificacao[i].descricao%>">
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <div class="column">
                    <h2>Pessoal</h2>
                    <% for(let i=0; i < gamificacao.length; i++) { %>
                        <% if(gamificacao[i].ag_gamificacao.id == 4) { %>
                            <div>
                                <input type="checkbox" name="ativo" value="<%=gamificacao[i].id%>">
                                <input type="text" name="descricao" value="<%=gamificacao[i].descricao%>">
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <div class="column">
                    <h2>Ficcional</h2>
                    <% for(let i=0; i < gamificacao.length; i++) { %>
                        <% if(gamificacao[i].ag_gamificacao.id == 5) { %>
                            <div>
                                <input type="checkbox" name="ativo" value="<%=gamificacao[i].id%>">
                                <input type="text" name="descricao" value="<%=gamificacao[i].descricao%>">
                            </div>
                        <% } %>
                    <% } %>
                </div>
            </div>

            <div>
                <input type="number" name="idPlanejamento" value="<%=planejamento%>" readonly hidden>
            </div>

            <button class="btn-principal"><a href="/turma/<%=planejamento%>">Voltar</a></button>
            <button class="btn-principal">Ajuda</button>
            <button type="submit" class="btn-principal">Próximo</button>
        </form>
    </div>
</body>
</html>