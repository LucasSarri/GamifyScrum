<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/style.css">
        <title>Gamificador</title>
    </head>
<body>
    <div class="centraliza_div">
        <h1>Cenário Desejado</h1>
        <form action="/cenario_desejado" method="post">
        <div class="form-columns">
            <div class="column">
                <% for(let i=0; i < Math.ceil(cenariosDesejados.length/2); i++) { %>
                    <div>
                        <input type="checkbox" name="cenariosDesejados" value="<%=cenariosDesejados[i].id%>"<% if (idsSugestoes.includes(cenariosDesejados[i].id)) { %> checked <% } %> >
                        <%=cenariosDesejados[i].descricao%>
                    </div>
                <% } %>
            </div>
            <div class="column">
                <% for(let i=Math.ceil(cenariosDesejados.length/2); i < cenariosDesejados.length; i++) { %>
                    <div>
                        <input type="checkbox" name="cenariosDesejados" value="<%=cenariosDesejados[i].id%>"<% if (idsSugestoes.includes(cenariosDesejados[i].id)) { %> checked <% } %> >
                        <%=cenariosDesejados[i].descricao%>
                    </div>
                <% } %>
            </div>
        </div>

            <div>
                <input type="number" name="idPlanejamento" value="<%=planejamento%>" readonly hidden>
            </div>

            <button class="btn-principal"><a href="/turma/<%=planejamento%>">Voltar</a></button>
            <button class="btn-principal">Ajuda</button>
            <button type="submit" class="btn-principal">Próximo</button>
        </form>
    </div>
</body>
</html>