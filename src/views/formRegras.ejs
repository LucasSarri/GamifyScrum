<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/style.css">
        <title>Gamificador</title>
    </head>
<body>
    <div class="centraliza_div">
        <h1>Regras</h1>
        <form action="/regras" method="post">
            <div class="form-columns">
                <div class="column">
                    <% for(let i=0; i < regras.length/2; i++) { %>
                        <div>
                            <input type="checkbox" name="ativo" value="<%=regras[i].id%>">
                            <%=regras[i].descricao%>
                        </div>
                    <% } %>
                </div>
    
                <div class="column">
                    <% for(let i=(regras.length/2); i < regras.length; i++) { %>
                        <div>
                            <input type="checkbox" name="ativo" value="<%=regras[i].id%>">
                            <%=regras[i].descricao%>
                        </div>
                    <% } %>
                </div>

                <div>
                    <input type="number" name="idPlanejamento" value="<%=planejamento%>" readonly hidden>
                </div>
            </div>

            <button class="btn-principal"><a href="/cenario_desejado/<%=planejamento%>">Voltar</a></button>
            <button type="submit" class="btn-principal">Próximo</button>
        </form>
    </div>
</body>
</html>