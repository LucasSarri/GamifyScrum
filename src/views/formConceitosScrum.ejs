<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/style.css">
        <title>Gamificador</title>
    </head>
<body>
    <div class="centraliza_div">
        <h1>Conceitos Scrum</h1>
        
        <form action="/conceito_scrum" method="post">
            <div class="form-columns">
                <div class="column">
                    <h2>Papéis</h2>
                    <% for(let i=0; i < conceitos_scrum.length; i++) { %>
                        <% if(conceitos_scrum[i].idAgScrum.id == 1) { %>
                            <div>
                                <input type="checkbox" name="ativo" value="<%=conceitos_scrum[i].id%>">
                                <%=conceitos_scrum[i].descricao%>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <div class="column">
                    <h2>Eventos</h2>
                    <% for(let i=0; i < conceitos_scrum.length; i++) { %>
                        <% if(conceitos_scrum[i].idAgScrum.id == 2) { %>
                            <div>
                                <input type="checkbox" name="ativo" value="<%=conceitos_scrum[i].id%>">
                                <%=conceitos_scrum[i].descricao%>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <div class="column">
                    <h2>Artefatos</h2>
                    <% for(let i=0; i < conceitos_scrum.length; i++) { %>
                        <% if(conceitos_scrum[i].idAgScrum.id == 3) { %>
                            <div>
                                <input type="checkbox" name="ativo" value="<%=conceitos_scrum[i].id%>">
                                <%=conceitos_scrum[i].descricao%>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            </div>

            <div>
                <input type="number" name="idPlanejamento" value="<%=planejamento%>" readonly hidden>
            </div>

            <button class="btn-principal"><a href="/regras/<%=planejamento%>">Voltar</a></button>
            <button type="submit" class="btn-principal">Próximo</button>
        </form>
    </div>
</body>
</html>