<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/style.css">
        <title>Gamificador</title>
    </head>
<body>
    <div class="container">
        <div class="row">
            <% semanas.forEach((semana) => { %>
                <div class="col border p-3">
                    <h5>Semana <%= semana.numero %></h5>
        
                    <form method="POST" action="/semanas/<%= semana.id %>/eventos">
                        <select name="eventos[]" multiple class="form-control">
                            <option value="Daily">Daily</option>
                            <option value="Planning">Sprint Planning</option>
                            <option value="Review">Sprint Review</option>
                            <option value="Retro">Retrospective</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary mt-2">Adicionar</button>
                    </form>

                    <ul>
                        <% semana.eventos.forEach((ev) => { %>
                            <li><%= ev.tipo %></li>
                        <% }) %>
                    </ul>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>