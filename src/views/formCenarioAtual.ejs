<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/style.css">
        <title>Gamificador</title>
    </head>
<body>
    <div class="centraliza_div">
        <h1>Cenário Atual</h1>
        <form action="/add_cenario_atual" method="post">
            <div class="form-columns">
                <div class="column">
                    <% for(let i=0; i < Math.ceil(cenariosAtuais.length/2); i++) { %>
                        <div>
                            <input type="checkbox" name="ativo" value="<%=cenariosAtuais[i].id%>">
                            <span><%=cenariosAtuais[i].descricao%></span>
                        </div>
                    <% } %>
                </div>
                <div class="column">
                    <% for(let i=Math.ceil(cenariosAtuais.length/2); i < cenariosAtuais.length; i++) { %>
                        <div>
                            <input type="checkbox" name="ativo" value="<%=cenariosAtuais[i].id%>">
                            <span><%=cenariosAtuais[i].descricao%></span>
                        </div>
                    <% } %>
                </div>
                <div>
                    <input type="number" name="idPlanejamento" value="<%=planejamento%>" readonly hidden>
                </div>
            </div>

            <button class="btn-principal"><a href="/turma/<%=planejamento%>">Voltar</a></button>
            <button class="btn-principal">Ajuda</button>
            <button type="submit" class="btn-principal">Próximo</button>
        </form>
    </div>
</body>
</html>